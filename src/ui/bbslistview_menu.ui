        <attribute name="label" translatable="yes">スレのプロパティ(_P)...</attribute>
        <attribute name="action">bbslist.PreferenceArticle</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">板のプロパティ(_O)...</attribute>
        <attribute name="action">bbslist.PreferenceBoard</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">画像のプロパティ(_M)...</attribute>
        <attribute name="action">bbslist.PreferenceImage</attribute>
      </item>
    </section>
  </menu>

  <!--  履歴 (複数選択) -->
  <menu id="popup_menu_history_mul">
    <item>
      <attribute name="label" translatable="yes">選択した行を開く(_O)</attribute>
      <attribute name="action">bbslist.OpenRows</attribute>
    </item>
    <section>
      <item>
        <attribute name="label" translatable="yes">お気に入りに追加(_F)...</attribute>
        <attribute name="action">bbslist.AppendFavorite</attribute>
      </item>
    </section>
    <section>
      <submenu>
        <attribute name="label" translatable="yes">更新チェック(_M)</attribute>
        <item>
          <attribute name="label" translatable="yes">更新チェックのみ(_H)</attribute>
          <attribute name="action">bbslist.CheckUpdateRows</attribute>
        </item>
        <item>
          <attribute name="label" translatable="yes">更新された行をタブで開く(_E)</attribute>
          <attribute name="action">bbslist.CheckUpdateOpenRows</attribute>
        </item>
        <section>
          <item>
            <attribute name="label" translatable="yes">キャンセル(_C)</attribute>
            <attribute name="action">bbslist.CancelCheckUpdate</attribute>
          </item>
        </section>
      </submenu>
    </section>
    <section>
      <submenu>
        <attribute name="label" translatable="yes">削除(_D)</attribute>
        <item>
          <attribute name="label" translatable="yes">履歴から削除する(_D)</attribute>
          <attribute name="action">bbslist.DeleteHist</attribute>
        </item>
      </submenu>
    </section>
  </menu>

  <!--  履歴 (仮想板) -->
  <menu id="popup_menu_history_vboard">
    <item>
      <attribute name="label" translatable="yes">タブで開く(_T)</attribute>
      <attribute name="action">bbslist.OpenTab</attribute>
    </item>
    <section>
      <submenu>
        <attribute name="label" translatable="yes">削除(_D)</attribute>
        <item>
          <attribute name="label" translatable="yes">履歴から削除する(_D)</attribute>
          <attribute name="action">bbslist.DeleteHist</attribute>
        </item>
      </submenu>
    </section>
  </menu>
</interface>
