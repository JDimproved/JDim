<interface>
  <!-- 板一覧 (板) -->
  <menu id="popup_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">タブで開く(_T)</attribute>
        <attribute name="action">bbslist.OpenTab</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">ブラウザで開く(_W)</attribute>
        <attribute name="action">bbslist.OpenBrowser</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">URLをコピー(_U)</attribute>
        <attribute name="action">bbslist.CopyURL</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">タイトルとURLをコピー(_L)</attribute>
        <attribute name="action">bbslist.CopyTitleURL</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">お気に入りに追加(_F)...</attribute>
        <attribute name="action">bbslist.AppendFavorite</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">キャッシュ内ログ検索(_S)</attribute>
        <attribute name="action">bbslist.SearchCacheBoard</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">datのインポート(_I)</attribute>
        <attribute name="action">bbslist.ImportDat</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">板のプロパティ(_O)...</attribute>
        <attribute name="action">bbslist.PreferenceBoard</attribute>
      </item>
    </section>
  </menu>

